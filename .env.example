# Copy to .env in the checkout. Real secrets belong only in that gitignored file.
# Step 1 does not connect to Telegram or access GPIO/cameras.
RANCHO_LOG_LEVEL=INFO
# Relative paths are resolved against the directory containing .env.
RANCHO_STATE_FILE=state.json

# Leave blank until the Telegram implementation step.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
