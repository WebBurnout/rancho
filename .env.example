# Copy to .env in the checkout. Real secrets belong only in that gitignored file.

# Set both to enable Telegram. Group IDs are usually negative integers.
# Everyone in an allowed group can use the bot. Multiple IDs: -123,-456.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Reolink cameras (names and addresses are in cameras.yaml): enable Basic
# service (9000). HTTP is not used.
# Shared credentials need discovery, snapshot, and event-subscription permissions.
CAMERA_USERNAME=
CAMERA_PASSWORD=

# Siren MOSFET on GPIO25. true only if your driver turns the siren on with a LOW pin.
SIREN_ACTIVE_LOW=false
