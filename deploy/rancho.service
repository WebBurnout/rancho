[Unit]
Description=Rancho alarm service
Wants=network-online.target zwave.service
# Only ordering: Rancho runs (and reports Z-Wave offline) without it.
After=network-online.target zwave.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=tim
Group=tim
# /dev/gpiochip0 is root:gpio.
SupplementaryGroups=gpio
WorkingDirectory=/home/tim/rancho
ExecStart=/home/tim/rancho/.venv/bin/python -m rancho
# GPIO outputs persist after the process exits; this turns off a siren left on
# by a crash or SIGKILL. Runs after every stop.
ExecStopPost=/home/tim/rancho/.venv/bin/python -m rancho.siren_off
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Python reads .env in WorkingDirectory; state.json will also live there.
UMask=0077
Restart=always
RestartSec=5
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rancho
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/tim/rancho

[Install]
WantedBy=multi-user.target
